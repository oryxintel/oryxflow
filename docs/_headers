# Cloudflare Pages custom response headers.
# https://developers.cloudflare.com/pages/configuration/headers/
#
# MkDocs copies this file verbatim to the site root (site/_headers), where
# Cloudflare Pages reads it. Material's own CSS/JS are content-hashed
# (main.<hash>.min.css, bundle.<hash>.min.js, palette.<hash>.min.css), so a
# new build ships a new filename — the old one can be cached forever without
# ever serving stale content. Only the hashed dirs get `immutable`; extra.css
# and _mkdocstrings.css are NOT hashed, so they keep the default revalidating
# cache and pick up edits on the next deploy.

/assets/stylesheets/*
  Cache-Control: public, max-age=31536000, immutable

/assets/javascripts/*
  Cache-Control: public, max-age=31536000, immutable

# Logo, favicon, and other images: long-lived but revalidatable (filenames are
# stable, not hashed, so don't mark immutable).
/assets/images/*
  Cache-Control: public, max-age=2592000

# Self-hosted Roboto / Roboto Mono. These names aren't content-hashed, but they
# get `immutable` anyway because the bytes behind a given name never change: the
# filename pins family + subset + axis, so a font revision arrives as a new
# filename rather than new content under an old one. That matters more here than
# elsewhere — a font is needed to paint text, so a revalidation round-trip on a
# repeat visit would delay exactly what we moved these off Google to speed up.
# If you ever do overwrite a font file in place, rename it in the same commit.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
